
@model Doctor

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow">

                <div class="card-header bg-warning">
                    <h4 class="mb-0">Edit Doctor</h4>
                </div>

                <div class="card-body">

                    <form asp-action="Edit" method="post">

                        <!-- ID -->
                        <input type="hidden" asp-for="Id" />


                        <!-- Name -->
                        <div class="mb-3">

                            <label asp-for="Name" class="form-label">
                                Doctor Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control" />

                        </div>


                        <!-- Specialization -->
                        <div class="mb-3">

                            <label asp-for="Specialization"
                                   class="form-label">

                                Specialization

                            </label>

                            <input asp-for="Specialization"
                                   class="form-control" />

                        </div>


                        <!-- Image -->
                        <div class="mb-3">

                            <label asp-for="Img"
                                   class="form-label">

                                Image

                            </label>

                            <input asp-for="Img"
                                   class="form-control" />

                        </div>


                        <!-- Buttons -->
                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-warning">

                                <i class="bi bi-save"></i>
                                Save Changes

                            </button>


                            <a asp-action="Index"
                               class="btn btn-secondary">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

